#stages VERTEX FRAGMENT

#include "default.shd"
// brings Matrices and Lighting into scope
// set 0 should not be used

layout(location = 0) in vec4 ColorAttribute;
layout(location = 1) in vec3 PositionAttribute;
layout(location = 2) in vec2 TextureCoordAttribute;

layout(location = 0) out vec2 texVarying;
layout(location = 1) out vec4 color_v;

layout(set = 1, binding = 0) uniform Material
{
    vec4 color;
};

#ifdef VERTEX_SHADER

void main()
{
    gl_Position =
        matrices.projection_matrix *
        matrices.view_matrix *
        matrices.matrix *
        vec4(PositionAttribute, 1.0);

    texVarying = TextureCoordAttribute;
    color_v = ColorAttribute * color;
}

#endif
#ifdef FRAGMENT_SHADER

layout(set = 1, binding = 1) uniform sampler2D textureSampler;

layout(location = 2) out vec4 FragColor;

void main()
{
#ifndef DEPTH_ONLY
    FragColor = color_v * texture(textureSampler, texVarying);
#endif
}

#endif
