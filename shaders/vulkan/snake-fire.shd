#stages VERTEX FRAGMENT

#include "default.shd"
// brings Matrices and Lighting into scope
// set 0 should not be used

#ifdef VERTEX_SHADER

layout(location = 0) in vec3 PositionAttribute;
layout(location = 1) in vec3 NormalAttribute;

layout(location = 0) out vec2 texVarying;

void main()
{
    vec4 p = matrices.matrix * vec4(PositionAttribute, 1.0);

    gl_Position = matrices.projection_matrix * matrices.view_matrix * p;

#ifndef DEPTH_ONLY
    texVarying =
        p.xy * 0.2 +
        NormalAttribute.xy * 0.4 +
        vec2(
            sin(lighting.time + p.x),
            cos(lighting.time * 0.9 + p.y)
        ) * 0.2;
#endif
}

#endif


#ifdef FRAGMENT_SHADER

layout(location = 0) in vec2 texVarying;

layout(location = 0) out vec4 outColor;

layout(set = 1, binding = 0) uniform sampler2D textureSampler;

layout(set = 1, binding = 1) uniform Material
{
    vec4 specular;
    vec4 color;
};

void main()
{
#ifndef DEPTH_ONLY

    vec3 c =
        color.rgb * 0.4 +
        texture(textureSampler, texVarying).rgb *
        vec3(0.5, 0.6, 0.1);

    c.g = min(c.r, c.g);

    outColor = vec4(c * 2.0, 1.0);

#endif
}

#endif
