#stages VERTEX FRAGMENT

#version 450#ifdef VERTEX_SHADER

layout(location = 0) in vec3 PositionAttribute;
layout(location = 1) in vec3 NormalAttribute;

layout(location = 0) out vec2 texVarying;

layout(set = 0, binding = 0) uniform Matrices
{
    mat4 matrix;
    mat4 projection_matrix;
    mat4 view_matrix;
    float time;
};

void main()
{
    vec4 p = matrix * vec4(PositionAttribute, 1.0);

    gl_Position = projection_matrix * view_matrix * p;

#ifndef DEPTH_ONLY
    texVarying =
        p.xy * 0.2 +
        NormalAttribute.xy * 0.4 +
        vec2(
            sin(time + p.x),
            cos(time * 0.9 + p.y)
        ) * 0.2;
#endif
}

#endif


#ifdef FRAGMENT_SHADER

layout(location = 0) in vec2 texVarying;

layout(location = 0) out vec4 outColor;

layout(set = 0, binding = 1) uniform sampler2D textureSampler;

layout(set = 0, binding = 2) uniform Material
{
    vec4 specular;
    vec4 color;
};

void main()
{
#ifndef DEPTH_ONLY

    vec3 c =
        color.rgb * 0.4 +
        texture(textureSampler, texVarying).rgb *
        vec3(0.5, 0.6, 0.1);

    c.g = min(c.r, c.g);

    outColor = vec4(c * 2.0, 1.0);

#endif
}

#endif
