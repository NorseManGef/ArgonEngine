#stages VERTEX FRAGMENT

#include "default.shd"
// brings Matrices and Lighting into scope
// set 0 should not be used

layout(set = 1, binding = 0, std140) uniform Material
{
    vec4 specular;
    vec4 color;
} material;

#ifdef VERTEX_SHADER

layout(location = 0) in vec3 PositionAttribute;
layout(location = 1) in vec3 NormalAttribute;

layout(location = 0) out vec3 ambient;
layout(location = 1) out vec3 normal;
layout(location = 2) out vec3 normal2;
layout(location = 3) out vec4 ecPos;
layout(location = 4) out vec4 screen_pos;

void main()
{
    ecPos = matrices.matrix * vec4(PositionAttribute, 1.0);

    screen_pos = matrices.projection_matrix *
                 (matrices.view_matrix * ecPos);

    gl_Position = screen_pos;

#ifndef DEPTH_ONLY

    ambient = vec3(0.2, 0.1, 0.05) * material.color.xyz;

    normal2 = mat3(matrices.view_matrix * matrices.normal_matrix) *
              NormalAttribute;

    normal = mat3(matrices.normal_matrix) *
             NormalAttribute;

#endif
}

#endif

#ifdef FRAGMENT_SHADER

layout(location = 2) in vec3 ambient;
layout(location = 3) in vec3 normal;
layout(location = 4) in vec3 normal2;
layout(location = 5) in vec4 ecPos;
layout(location = 6) in vec4 screen_pos;

layout(location = 5) out vec4 fragColor;

layout(set = 1, binding = 1) uniform sampler2D textureSampler;

void main()
{
    vec3 origin = gl_FragCoord.xyz /
                  vec3(lighting.viewport.xy, 1.0);

#ifndef DEPTH_ONLY

    vec3 pos = ecPos.xyz / ecPos.w;

    const vec4 specular_exponent = vec4(1000.0);

    vec3 n = normalize(normal);
    vec3 n2 = normalize(normal2);
    vec3 view = normalize(lighting.camera_pos.xyz - pos);

    vec3 spec_color = vec3(1.0);

    vec3 att_accum = vec3(0.0);

    vec3 c = calculate_lighting_blinn_phong(
        pos,
        n,
        view,
        ambient,
        vec3(1.0),
        material.color.rgb,
        100.0
    );

    c += pow(
        texture(
            textureSampler,
            n2.xy * 0.3 + 0.5
        ).xyz,
        vec3(4.0)
    ) * 0.25;

    fragColor = vec4(c, 1.0);

#endif

#ifdef DEPTH_ONLY

    fragColor = vec4(0.0, 0.0, 0.0, origin.z);

#endif
}

#endif
