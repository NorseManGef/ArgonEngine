#stages VERTEX FRAGMENT

#include "default.shd"
// brings Matrices and Lighting into scope
// set 0 should not be used

layout(location = 0) in mediump vec4 color;
#ifdef VERTEX_SHADER
layout(location = 1) in vec3 PositionAttribute;

void main()
{
    vec4 pos= matrices.matrix * vec4(PositionAttribute,1.);
    gl_Position = matrices.projection_matrix*(matrices.view_matrix*pos);
}
#endif

#ifdef FRAGMENT_SHADER
layout(location = 0) out vec4 outColor;

void main() {
  outColor = color;
}
