#stages VERTEX FRAGMENT

#version 450


layout(set = 0, binding = 0) uniform Globals
{
    mat4 matrix;
    mat4 view_matrix;
    mat4 projection_matrix;
    vec4 color;
} globals;

#ifdef VERTEX_SHADER
layout(location = 0) in vec3 PositionAttribute;

void main()
{
    vec4 pos= globals.matrix * vec4(PositionAttribute,1.);
    gl_Position = globals.projection_matrix*(globals.view_matrix*pos);
}
#endif

#ifdef FRAGMENT_SHADER
layout(location = 0) out vec4 outColor;

void main() {
  outColor = globals.color;
}
